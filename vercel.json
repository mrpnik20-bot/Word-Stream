{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix vercel-app install --no-audit --no-fund",
  "buildCommand": "npm --prefix vercel-app run build",
  "outputDirectory": "vercel-app/dist",
  "rewrites": [{ "source": "/upload", "destination": "/index.html" }]
}